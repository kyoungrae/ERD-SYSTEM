# Server Environment Variables
NODE_ENV=development
PORT=3001

# MongoDB (운영 서버)
MONGODB_URI=mongodb://192.168.0.232:27017/erd-system

# Redis (운영 서버)
REDIS_HOST=192.168.0.232
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=dev-jwt-secret-key-for-local-development
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
